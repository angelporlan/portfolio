---
import type { CollectionEntry } from "astro:content";
import { getLangFromUrl, useTranslatedPath } from "../i18n/utils";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);

const formattedDate = post.data.date.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article
  class="group relative flex flex-col justify-between p-6 rounded-2xl border border-gray-200/50 dark:border-gray-800/50 bg-white/40 dark:bg-gray-900/30 backdrop-blur-md shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-blue-500/50 dark:hover:border-blue-500/50 hover:bg-white/60 dark:hover:bg-gray-900/50"
  data-tags={post.data.tags.join(",")}
>
  <a href={translatePath(`/blog/${post.slug}`)} class="flex flex-col h-full justify-between w-full">
    <div>
      <div class="flex flex-wrap gap-x-2 gap-y-1.5 mb-4">
        {
          post.data.tags.map((tag) => (
            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-100/50 dark:border-blue-900/30">
              {tag}
            </span>
          ))
        }
      </div>
      <h3 class="text-xl font-bold text-gray-800 dark:text-gray-100 group-hover:text-blue-500 dark:group-hover:text-blue-400 transition-colors duration-200 line-clamp-2">
        {post.data.title}
      </h3>
      <p class="text-sm text-gray-600 dark:text-gray-400 mt-2 line-clamp-3 leading-relaxed">
        {post.data.subtitle}
      </p>
    </div>
    <div class="mt-6 flex flex-row items-center justify-between w-full text-xs text-gray-500 dark:text-gray-400">
      <time datetime={post.data.date.toISOString()}>
        {formattedDate}
      </time>
      <span class="inline-flex items-center gap-1 font-semibold text-blue-500 dark:text-blue-400 group-hover:translate-x-1 transition-transform duration-200">
        {lang === "es" ? "Leer artículo" : "Read post"} &rarr;
      </span>
    </div>
  </a>
</article>

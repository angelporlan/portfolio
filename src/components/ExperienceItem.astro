---
import LinkInline from "./LinkInline.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
}

const { title, company, description, link, date } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4]"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span
        class="absolute -left-[42px] top-1.5 flex h-4 w-4 items-center justify-center rounded-full bg-amber-500/20 ring-4 ring-gray-50 dark:ring-gray-950"
      >
        <span class="h-2 w-2 rounded-full bg-amber-500"></span>
      </span>

      <h3 class="text-xl font-bold text-amber-600 dark:text-amber-400">{title}</h3>
      <h4 class="font-semibold text-lg text-gray-800 dark:text-white">
        {company}
      </h4>
      <time class="p-0 m-0 text-sm font-mono text-gray-500 dark:text-gray-400"
        >{date}</time
      >
    </div>
  </div>
  <div
    class="relative flex flex-col gap-2 pb-4 text-gray-600 dark:text-gray-300 md:col-span-3"
  >
    <div set:html={description} class="text-pretty" />
    {
      link && (
        <LinkInline href={link}>
          {t("experience.more")}{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </>
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>

---
import ThemeToggle from "./ThemeToggle.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import LanguagePicker from "./LanguagePicker.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const navItems = [
  {
    title: t("nav.experience"),
    label: "experiencia",
    url: translatePath("/#experiencia"),
  },
  {
    title: t("nav.projects"),
    label: "proyectos",
    url: translatePath("/#proyectos"),
  },
  {
    title: t("nav.stack"),
    label: "stack",
    url: translatePath("/#stack"),
  },
  {
    title: t("nav.about"),
    label: "sobre-mi",
    url: translatePath("/#sobre-mi"),
  },
  {
    title: t("nav.blog"),
    label: "blog",
    url: translatePath("/blog"),
  },
  {
    title: t("nav.contact"),
    label: "contacto",
    url: "mailto:angelporlandev@gmail.com",
  },
];
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-3 text-sm font-medium rounded-full text-gray-600 dark:text-gray-200 justify-center items-center"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-blue-500 dark:hover:text-blue-500"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
    <ThemeToggle />
    <LanguagePicker />
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const activeNavOnBlog = () => {
      const isBlog = window.location.pathname.includes("/blog");
      if (isBlog) {
        navItems.forEach((item) => {
          if (item.getAttribute("aria-label") === "blog") {
            item.classList.add("text-blue-500");
          } else {
            item.classList.remove("text-blue-500");
          }
        });
        return true;
      }
      return false;
    };

    const callback = (entries: any[]) => {
      if (activeNavOnBlog()) return;
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-blue-500");
            } else {
              item.classList.remove("text-blue-500");
            }
          });
        }
      });
    };

    const isBlogActive = activeNavOnBlog();

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    if (!isBlogActive) {
      sections.forEach((section) => {
        observer.observe(section);
      });
    }

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        if (!window.location.pathname.includes("/blog")) {
          sections.forEach((section) => {
            observer.observe(section);
          });
        }
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    0% {
      background-color: transparent;
      backdrop-filter: blur(0px);
      border: 1px solid transparent;
    }
    to {
      box-shadow:
        0 5px 50px -5px rgba(0, 0, 0, 0.1),
        0 0 0 1px rgba(0, 0, 0, 0.1);

      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.3);
    }
  }
  :global(.dark) @keyframes nav-shadown {
    0% {
      background-color: transparent;
      backdrop-filter: blur(0px);
    }
    to {
      box-shadow:
        0 10px 40px -10px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.1);

      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
  }
</style>

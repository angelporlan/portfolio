---
import ThemeToggle from "./ThemeToggle.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import LanguagePicker from "./LanguagePicker.astro";

interface Props {
  translatedUrl?: string;
}

const { translatedUrl } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const navItems = [
  {
    title: t("nav.experience"),
    label: "experiencia",
    url: translatePath("/#experiencia"),
  },
  {
    title: t("nav.projects"),
    label: "proyectos",
    url: translatePath("/#proyectos"),
  },
  {
    title: t("nav.stack"),
    label: "stack",
    url: translatePath("/#stack"),
  },
  {
    title: t("nav.about"),
    label: "sobre-mi",
    url: translatePath("/#sobre-mi"),
  },
  {
    title: t("nav.blog"),
    label: "blog",
    url: translatePath("/blog"),
  },
  {
    title: t("nav.contact"),
    label: "contacto",
    url: "mailto:angelporlandev@gmail.com",
  },
];
---

<header
  class="fixed top-0 z-30 flex items-center justify-center w-full mx-auto mt-2 px-2 pointer-events-none"
>
  <nav
    class="pointer-events-auto flex items-center max-w-[calc(100vw-1rem)] sm:max-w-fit overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden px-2 sm:px-3 py-1 text-xs sm:text-sm font-medium rounded-full text-gray-700 dark:text-gray-200 justify-start sm:justify-center border border-gray-200/60 dark:border-white/10 shadow-sm backdrop-blur-md bg-white/80 dark:bg-[#121316]/80"
  >
    <div class="flex items-center gap-0.5 sm:gap-1 shrink-0 whitespace-nowrap">
      {
        navItems.map((link) => (
          <a
            class="relative block px-1.5 sm:px-2 py-1 sm:py-1.5 rounded-full transition hover:text-blue-500 dark:hover:text-blue-400 shrink-0 whitespace-nowrap"
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
      <div class="flex items-center pl-1 ml-0.5 sm:ml-1 border-l border-gray-300 dark:border-gray-700 shrink-0">
        <ThemeToggle />
        <LanguagePicker translatedUrl={translatedUrl} />
      </div>
    </div>
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section");
    const navItems = document.querySelectorAll("header nav a");

    const activeNavOnBlog = () => {
      const isBlog = window.location.pathname.includes("/blog");
      if (isBlog) {
        navItems.forEach((item) => {
          if (item.getAttribute("aria-label") === "blog") {
            item.classList.add("text-blue-500");
          } else {
            item.classList.remove("text-blue-500");
          }
        });
        return true;
      }
      return false;
    };

    const callback = (entries: any[]) => {
      if (activeNavOnBlog()) return;
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-blue-500");
            } else {
              item.classList.remove("text-blue-500");
            }
          });
        }
      });
    };

    const isBlogActive = activeNavOnBlog();

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.3,
    });

    if (!isBlogActive) {
      sections.forEach((section) => {
        observer.observe(section);
      });
    }

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect();
      } else {
        if (!window.location.pathname.includes("/blog")) {
          sections.forEach((section) => {
            observer.observe(section);
          });
        }
      }
    };
  });
</script>

<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-shadown {
    0% {
      background-color: transparent;
      backdrop-filter: blur(0px);
      border: 1px solid transparent;
    }
    to {
      box-shadow:
        0 5px 50px -5px rgba(0, 0, 0, 0.1),
        0 0 0 1px rgba(0, 0, 0, 0.1);

      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.3);
    }
  }
  :global(.dark) @keyframes nav-shadown {
    0% {
      background-color: transparent;
      backdrop-filter: blur(0px);
    }
    to {
      box-shadow:
        0 10px 40px -10px rgba(0, 0, 0, 0.5),
        0 0 0 1px rgba(255, 255, 255, 0.1);

      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
  }
</style>

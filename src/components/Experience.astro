---
import ExperienceItem from "./ExperienceItem.astro";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const EXPERIENCE_ES = [
  {
    date: "Abril 2025 - Actualidad",
    title: "Full Stack Developer",
    company: "ENAE Business School",
    description: `
      <ul class="list-disc pl-4 space-y-2 text-gray-700 dark:text-gray-300">
        <li>Desarrollo de integraciones entre sistemas y servicios externos</li>
        <li>Automatización de procesos de negocio mediante APIs</li>
        <li>Implementación de soluciones backend con Laravel y PHP</li>
        <li>Sincronización de datos en tiempo real y mejora de trazabilidad</li>
        <li>Aplicación de soluciones técnicas con enfoque en eficiencia y escalabilidad</li>
      </ul>
    `
  },
  {
    date: "Marzo 2024 - Junio 2024",
    title: "Full Stack Developer",
    company: "SevenSystem",
    description: `
      <ul class="list-disc pl-4 space-y-2 text-gray-700 dark:text-gray-300">
        <li>Desarrollo de interfaces modernas a partir de diseños en Figma</li>
        <li>Creación de componentes reutilizables y escalables</li>
        <li>Desarrollo de APIs RESTful con control de acceso y validaciones</li>
        <li>Optimización de rendimiento en frontend y backend</li>
        <li>Participación en proyectos reales orientados a cliente</li>
      </ul>
    `
  }
];

const EXPERIENCE_EN = [
  {
    date: "April 2025 - Present",
    title: "Full Stack Developer",
    company: "ENAE Business School",
    description: `
      <ul class="list-disc pl-4 space-y-2 text-gray-700 dark:text-gray-300">
        <li>Development of integrations between systems and external services</li>
        <li>Automation of business processes using APIs</li>
        <li>Implementation of backend solutions with Laravel and PHP</li>
        <li>Real-time data synchronization and improved traceability</li>
        <li>Application of technical solutions with a focus on efficiency and scalability</li>
      </ul>
    `
  },
  {
    date: "March 2024 - June 2024",
    title: "Full Stack Developer",
    company: "SevenSystem",
    description: `
      <ul class="list-disc pl-4 space-y-2 text-gray-700 dark:text-gray-300">
        <li>Development of modern interfaces from Figma designs</li>
        <li>Creation of reusable and scalable components</li>
        <li>Development of RESTful APIs with access control and validations</li>
        <li>Frontend and backend performance optimization</li>
        <li>Participation in real client-oriented projects</li>
      </ul>
    `
  }
];

const EXPERIENCE = lang === "en" ? EXPERIENCE_EN : EXPERIENCE_ES;
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>

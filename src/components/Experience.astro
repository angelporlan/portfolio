---
import ExperienceItem from "./ExperienceItem.astro";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const EXPERIENCE_ES = [
  {
    date: "Abril 2025 - Actualidad",
    title: "Full Stack Developer",
    company: "ENAE Business School",
    description: `
      <ul class="list-disc pl-4 space-y-2.5 text-gray-700 dark:text-gray-300">
        <li><strong>Arquitectura de integraciones:</strong> Desarrollo de servicios y conexiones críticas entre el ecosistema institucional y plataformas externas mediante APIs RESTful en <em>Laravel y PHP</em>.</li>
        <li><strong>Automatización de procesos:</strong> Automatización integral de pipelines de matriculación y flujos de negocio, reduciendo tiempos manuales de gestión y fricción operativa.</li>
        <li><strong>Trazabilidad y datos en tiempo real:</strong> Sincronización transaccional de datos y mejora de observabilidad para garantizar integridad en bases de datos relacionales.</li>
        <li><strong>Optimización y resiliencia:</strong> Refactorización continua orientada a escalabilidad, alta concurrencia y tolerancia a fallos.</li>
      </ul>
    `
  },
  {
    date: "Marzo 2024 - Junio 2024",
    title: "Full Stack Developer",
    company: "SevenSystem",
    description: `
      <ul class="list-disc pl-4 space-y-2.5 text-gray-700 dark:text-gray-300">
        <li><strong>Ingeniería frontend de alta fidelidad:</strong> Construcción de interfaces responsivas y modulares a partir de especificaciones en Figma con <em>React, TypeScript y Tailwind CSS</em>.</li>
        <li><strong>APIs RESTful seguras:</strong> Implementación de servicios backend con control de acceso por roles (RBAC), autenticación JWT y validación estricta de payloads.</li>
        <li><strong>Rendimiento web:</strong> Optimización de Core Web Vitals y tiempos de carga tanto en renderizado cliente como en latencia de respuestas del servidor.</li>
      </ul>
    `
  }
];

const EXPERIENCE_EN = [
  {
    date: "April 2025 - Present",
    title: "Full Stack Developer",
    company: "ENAE Business School",
    description: `
      <ul class="list-disc pl-4 space-y-2.5 text-gray-700 dark:text-gray-300">
        <li><strong>Integration Architecture:</strong> Designed and implemented critical integration microservices connecting institutional CRM systems with external platforms via RESTful APIs using <em>Laravel and PHP</em>.</li>
        <li><strong>Workflow Automation:</strong> End-to-end automation of business processes and enrollment funnels, cutting down manual overhead and operational latency.</li>
        <li><strong>Real-time Data & Traceability:</strong> Transactional data synchronization pipelines ensuring consistency, audit trails, and data integrity.</li>
        <li><strong>Scalability & Resilience:</strong> Continuous refactoring focused on throughput, high concurrency handling, and fault tolerance.</li>
      </ul>
    `
  },
  {
    date: "March 2024 - June 2024",
    title: "Full Stack Developer",
    company: "SevenSystem",
    description: `
      <ul class="list-disc pl-4 space-y-2.5 text-gray-700 dark:text-gray-300">
        <li><strong>High-Fidelity Frontend Engineering:</strong> Built responsive, component-driven user interfaces from Figma specifications using <em>React, TypeScript, and Tailwind CSS</em>.</li>
        <li><strong>Secure RESTful APIs:</strong> Developed backend endpoints with role-based access control (RBAC), JWT authentication, and strict payload validation.</li>
        <li><strong>Web Performance:</strong> Tuned client-side rendering and API response times, measurably improving Core Web Vitals and throughput.</li>
      </ul>
    `
  }
];

const EXPERIENCE = lang === "en" ? EXPERIENCE_EN : EXPERIENCE_ES;
---

<ol class="relative mt-16">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>

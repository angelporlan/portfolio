---
const personalImageAlt = "Ángel Porlán";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
import CV from "./icons/CV.astro";
import GitHub from "./icons/GitHub.astro";
import CodeIcon from "./gsap-decoration/CodeIcon.astro";
import Badge from "./Badge.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<script>
  import { gsap } from "gsap";
  import SplitType from "split-type";
  const text = document.querySelector("h1");
  const container = document.getElementById("container");

  // animacion del titulo
  gsap.from(text, {
    y: -100,
    opacity: 0,
    rotation: "random(-80, 80)",
    duration: 1.5,
    ease: "back",
    stagger: 0.15,
  });

  // animacion del texto
  document.fonts.ready.then(() => {
    gsap.set(container, { opacity: 1 });
    let split = new SplitType("#animate-me", { types: "words" });

    gsap.from(split.words, {
      opacity: 0,
      duration: 1,
      ease: "sine.out",
      stagger: 0.01,
    });
  });
</script>

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <div class="relative">
      <img
        class="rounded-full shadow-lg size-16"
        style="width: 100px; height: 100px; object-fit: cover;"
        src="/fondoazul.png"
        alt={personalImageAlt}
      />
      <div class="absolute top-0 right-0">
        <CodeIcon urlimage="/favicon.svg" />
      </div>
    </div>

    <!-- <div class="flex flex-col justify-center">
      <div class="flex items-center gap-2">
        <a
          href="https://linkedin.com/in/angelporlan"
          target="_blank"
          rel="noopener"
          class="flex justify-center items-center"
        >
          <Badge>{t("badge.available")}</Badge>
        </a>
      </div>
    </div> -->
  </div>

  <div id="container">
    <h1
      class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
    >
      {t("hero.title")}
    </h1>
    <h2
      class="text-xl font-semibold text-yellow-500 dark:text-yellow-200 mt-2"
    >
      {t("hero.subtitle")}
    </h2>
    <p
      id="animate-me"
      class="mt-6 text-lg text-gray-800 dark:text-gray-300 text-pretty"
    >
      <strong>{t("hero.description1")}</strong> {t("hero.description2")}
    </p>
    <p
      class="mt-6 text-md text-gray-600 dark:text-gray-400 font-medium"
    >
      <span>📍 {t("hero.location")}</span>
    </p>
    <nav class="flex flex-wrap gap-4 mt-8">
      <SocialPill href="mailto:angelporlandev@gmail.com">
        <MailIcon class="size-4" />
        {t("hero.contact")}
      </SocialPill>
      <SocialPill href="https://linkedin.com/in/angelporlan">
        <LinkedInIcon class="size-4" />
        LinkedIn
      </SocialPill>
      <SocialPill href="https://github.com/angelporlan">
        <GitHub class="size-4" />
        GitHub
      </SocialPill>
      <SocialPill href="/pdf/CV_Angel.pdf">
        <CV class="size-4" />
        CV
      </SocialPill>
    </nav>
  </div>
</div>

---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import Symfony from "./icons/Symfony.astro";
import NodeJS from "./icons/Node.astro";
import VueJS from "./icons/Vue.astro";
import Angular from "./icons/Angular.astro";
import OpenAiApi from "./icons/OpenAiApi.astro";
import Sparkles from "./icons/Sparkles.astro";
import Python from "./icons/Python.astro";
import ReactIcon from "./icons/React.astro";
import Book from "./icons/Book.astro";
import OpenBotMockup from "./OpenBotMockup.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  VUE: {
    name: "Vue.js",
    class: "bg-[#41B883] text-white flex items-center",
    icon: VueJS,
  },
  SYMFONY: {
    name: "Symfony",
    class: "bg-[#000000] text-white flex items-center",
    icon: Symfony,
  },
  NodeJS: {
    name: "Node.js",
    class: "bg-[#339933] text-white flex items-center gap-1",
    icon: NodeJS,
  },
  ANGULAR: {
    name: "Angular",
    class: "bg-[#DD0031] text-white flex items-center gap-1",
    icon: Angular,
  },
  OPENAI_API: {
    name: "OpenAI API",
    class: "bg-[#000] text-white flex items-center",
    icon: OpenAiApi,
  },
  AI: {
    name: "AI & LLMs",
    class: "bg-[#6366F1] text-white flex items-center gap-1",
    icon: Sparkles,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#3776AB] text-white flex items-center gap-1",
    icon: Python,
  },
  REACT_NATIVE: {
    name: "React Native / Expo",
    class: "bg-[#20232A] text-white flex items-center gap-1",
    icon: ReactIcon,
  },
  REDIS: {
    name: "Redis & BullMQ",
    class: "bg-[#DC382D] text-white flex items-center gap-1",
    icon: Sparkles,
  },
  MCP: {
    name: "MCP Protocol",
    class: "bg-[#0D9488] text-white flex items-center gap-1",
    icon: Sparkles,
  },
  OPENBOT: {
    name: "OpenBot Agents",
    class: "bg-[#7C3AED] text-white flex items-center gap-1",
    icon: Sparkles,
  },
};

const PROJECTS_ES = [
  {
    featured: true,
    title: "Matchply",
    subtitle: "SaaS de IA para optimización de CVs y tracking de candidaturas",
    description:
      "Plataforma inteligente que optimiza currículums automáticamente a partir de ofertas de empleo. Analiza la oferta en tiempo real mediante modelos de lenguaje, adapta el perfil del candidato de forma estratégica y facilita el seguimiento completo del proceso de postulación con generación de PDFs concurrentes y persistencia optimizada en PostgreSQL.",
    highlights: [
      "Optimización de consultas (-37.5% SELECTs en producción)",
      "Orquestación de agentes y evaluación de prompts RAG",
      "Renderizado concurrente de PDFs con workers dedicados",
      "Infraestructura en producción en VPS con CI/CD automatizado",
    ],
    github: "https://github.com/angelporlan",
    link: "https://matchply.com",
    caseStudy: "/blog/2026-10-22/rendimiento-matchply-antes-despues",
    image: "/projects/matchply.webp",
    tags: [TAGS.AI, TAGS.NEXT, TAGS.TAILWIND],
  },
  {
    featured: true,
    title: "LeadOn",
    subtitle: "CRM inteligente con IA para gestión de clientes y automatización de ventas",
    description:
      "Plataforma SaaS en producción con usuarios de pago orientada a la gestión comercial y automatización de flujos de clientes para freelancers y equipos de ventas. Co-fundado junto a Álvaro Vela (Sales), donde lidero la ingeniería de producto y la arquitectura: backend en Node/Express con colas asíncronas BullMQ y Redis, cliente móvil en Expo/React Native con sincronización offline-first, pagos vía Stripe Connect, OAuth 2.0 y servidor MCP para extender las capacidades con agentes de IA.",
    highlights: [
      "SaaS en producción real con usuarios activos de pago (leadonservice.com)",
      "Arquitectura backend distribuida con colas asíncronas BullMQ y Redis",
      "Aplicación móvil Expo / React Native con persistencia y sincronización offline-first",
      "Servidor MCP nativo integrado para orquestación e interoperabilidad con IA",
    ],
    link: "https://leadonservice.com",
    caseStudy: "/blog/2026-08-23/nexo-leadon-experimento-crm-ia",
    image: "/projects/leadon.webp",
    tags: [TAGS.AI, TAGS.NodeJS, TAGS.REACT_NATIVE, TAGS.REDIS, TAGS.MCP],
  },
  {
    featured: false,
    title: "Autonomous Software Factory",
    subtitle: "Ecosistema de ingeniería asistida por agentes autónomos sobre OpenBot",
    description:
      "Factoría de software distribuida basada en OpenBot que orquesta un equipo de agentes locales y en VPS (Product Lead, Full-Stack Dev, Research, Risk Sentinel y Telegram Orchestrator). Automatiza el ciclo completo de desarrollo: desde diagnóstico en caliente y testing hasta despliegues continuos auditados mediante Pull Requests, operando con herramientas del mundo real vía el estándar MCP.",
    highlights: [
      "Orquestación multi-agente con roles segregados y compuertas de verificación",
      "Integración profunda con servidores MCP (Computer Use, GitHub API, VPS SSH)",
      "Despliegues continuos en producción con auditoría y control de regresiones",
      "Monitorización y control en tiempo real sincronizado vía Telegram",
    ],
    caseStudy: "/blog/2026-06-28/como-automatice-orquestacion-agentes",
    image: "/projects/software-factory.jpg",
    isMockup: true,
    tags: [TAGS.AI, TAGS.OPENBOT, TAGS.PYTHON, TAGS.MCP],
  },
];

const PROJECTS_EN = [
  {
    featured: true,
    title: "Matchply",
    subtitle: "AI-Powered SaaS for Resume Optimization & Job Pipeline Tracking",
    description:
      "Intelligent platform that automatically optimizes resumes based on job postings. It analyzes requirements in real-time using LLMs, strategically tailors candidate profiles, and provides end-to-end application tracking with concurrent PDF generation and optimized PostgreSQL persistence.",
    highlights: [
      "Database query reduction (-37.5% SELECT overhead)",
      "Multi-agent orchestration & RAG prompt evaluation",
      "Concurrent PDF rendering via dedicated workers",
      "Production deployment on VPS with automated CI/CD",
    ],
    github: "https://github.com/angelporlan",
    link: "https://matchply.com",
    caseStudy: "/en/blog/2026-10-22/matchply-performance-before-after",
    image: "/projects/matchply.webp",
    tags: [TAGS.AI, TAGS.NEXT, TAGS.TAILWIND],
  },
  {
    featured: true,
    title: "LeadOn",
    subtitle: "AI-Driven CRM for Freelancers & Commercial Sales Automation",
    description:
      "Commercial SaaS platform with paying users designed for sales cycle acceleration and automated lead workflows. Co-founded with Álvaro Vela (Head of Sales), where I serve as Product Engineer leading the end-to-end architecture: Node/Express backend with BullMQ and Redis task queues, cross-platform Expo/React Native mobile app with offline-first synchronization, Stripe Connect payments, OAuth 2.0, and native MCP server for AI agent integration.",
    highlights: [
      "Live commercial SaaS with active paying clients (leadonservice.com)",
      "Distributed backend architecture with BullMQ queues and Redis",
      "Mobile client in Expo / React Native with offline-first synchronization",
      "Native MCP (Model Context Protocol) server for AI agent extensibility",
    ],
    link: "https://leadonservice.com",
    caseStudy: "/en/blog/2026-08-23/nexo-leadon-crm-ai-experiment",
    image: "/projects/leadon.webp",
    tags: [TAGS.AI, TAGS.NodeJS, TAGS.REACT_NATIVE, TAGS.REDIS, TAGS.MCP],
  },
  {
    featured: false,
    title: "Autonomous Software Factory",
    subtitle: "Multi-Agent Autonomous Software Engineering Ecosystem on OpenBot",
    description:
      "Distributed autonomous software engineering ecosystem built on OpenBot that coordinates local and VPS-based agents (Product Lead, Full-Stack Dev, Research, Risk Sentinel, and Telegram Orchestrator). Automates the complete development lifecycle: hot diagnostics, continuous testing, audited Pull Request releases, and real-world tools via the MCP standard.",
    highlights: [
      "Multi-agent orchestration with segregated responsibilities and verification gates",
      "Deep integration with MCP servers (Computer Use, GitHub API, VPS SSH)",
      "Automated production deployments and regression guardrails",
      "Real-time monitoring and bi-directional control via Telegram",
    ],
    caseStudy: "/en/blog/2026-06-28/how-i-automated-agent-orchestration",
    image: "/projects/software-factory.jpg",
    isMockup: true,
    tags: [TAGS.AI, TAGS.OPENBOT, TAGS.PYTHON, TAGS.MCP],
  },
];

const PROJECTS = lang === "en" ? PROJECTS_EN : PROJECTS_ES;
---

<div class="flex flex-col gap-y-12">
  {
    PROJECTS.map(
      ({ featured, image, title, subtitle, description, highlights, tags, link, github, caseStudy, isMockup }) => (
        <article
          class={`relative rounded-2xl transition duration-300 p-6 md:p-8 ${
            featured
              ? "bg-gradient-to-b from-amber-500/5 via-transparent to-transparent border-2 border-amber-500/30 dark:border-amber-400/20 shadow-xl dark:shadow-amber-950/10"
              : "border border-gray-200 dark:border-gray-800/80 bg-white/40 dark:bg-gray-900/30 hover:border-gray-300 dark:hover:border-gray-700 shadow-sm"
          }`}
        >
          {featured && (
            <div class="mb-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium tracking-wide uppercase bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              <Sparkles class="size-3.5" />
              {t("projects.featured")}
            </div>
          )}

          {isMockup || title.includes("Autonomous Software Factory") ? (
            /* Autonomous Software Factory: Always 1 column layout for maximum breathing room */
            <div class="flex flex-col gap-6 w-full">
              <div>
                <h3 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                  {title}
                </h3>
                {subtitle && (
                  <p class="text-sm font-medium text-amber-600 dark:text-amber-400 mt-1">
                    {subtitle}
                  </p>
                )}

                <div class="flex flex-wrap gap-2 mt-3">
                  {tags.map((tag) => (
                    <span
                      class={`inline-flex items-center gap-x-1.5 rounded-full text-xs font-medium ${tag.class} py-1 px-2.5`}
                    >
                      <tag.icon class="size-3.5" />
                      {tag.name}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Full-width OpenBot mockup preview -->
              <div class="w-full my-1">
                <OpenBotMockup lang={lang} />
              </div>

              <div>
                <p class="text-sm md:text-base leading-relaxed text-gray-700 dark:text-gray-300 text-pretty">
                  {description}
                </p>

                {highlights && highlights.length > 0 && (
                  <ul class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs md:text-sm text-gray-600 dark:text-gray-400">
                    {highlights.map((item) => (
                      <li class="flex items-center gap-2">
                        <span class="text-amber-500 font-bold">›</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}

                <footer class="flex flex-wrap items-center justify-start mt-6 gap-3">
                  {caseStudy && (
                    <LinkButton href={caseStudy} class="border-amber-500/30 text-amber-600 dark:text-amber-400 hover:bg-amber-500/10">
                      <Book class="size-4" />
                      {t("projects.case_study")}
                    </LinkButton>
                  )}
                  {link && (
                    <LinkButton href={link}>
                      <Link class="size-4" />
                      Preview
                    </LinkButton>
                  )}
                  {github && (
                    <LinkButton href={github}>
                      <GitHub class="size-4" />
                      Code
                    </LinkButton>
                  )}
                </footer>
              </div>
            </div>
          ) : (
            /* LeadOn & Matchply: 2-column on desktop, full image display, zoom on click */
            <div class="flex flex-col gap-8 md:flex-row md:items-start">
              <div class="w-full md:w-1/2">
                <div
                  class="project-image-trigger group relative overflow-hidden rounded-xl border border-gray-200/80 dark:border-gray-800 bg-[#0e1015] shadow-md cursor-zoom-in"
                  data-modal-image={image}
                  data-modal-title={title}
                  role="button"
                  tabindex="0"
                  aria-label={`Ver captura completa de ${title}`}
                >
                  <img
                    alt={`${title} preview`}
                    class="w-full h-auto max-h-[380px] object-contain object-top transition duration-300 group-hover:scale-[1.02]"
                    loading="lazy"
                    src={image}
                  />
                  <!-- Zoom overlay badge -->
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-colors flex items-center justify-center pointer-events-none">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/80 text-white text-xs font-medium backdrop-blur-md shadow-xl opacity-0 group-hover:opacity-100 transition-opacity transform translate-y-1 group-hover:translate-y-0 border border-white/10">
                      <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        <line x1="11" y1="8" x2="11" y2="14"></line>
                        <line x1="8" y1="11" x2="14" y2="11"></line>
                      </svg>
                      <span>{lang === "en" ? "Click to expand" : "Ampliar captura"}</span>
                    </span>
                  </div>
                </div>
              </div>

              <div class="w-full md:w-1/2 flex flex-col justify-between">
                <div>
                  <h3 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                    {title}
                  </h3>
                  {subtitle && (
                    <p class="text-sm font-medium text-amber-600 dark:text-amber-400 mt-1">
                      {subtitle}
                    </p>
                  )}

                  <div class="flex flex-wrap gap-2 mt-3">
                    {tags.map((tag) => (
                      <span
                        class={`inline-flex items-center gap-x-1.5 rounded-full text-xs font-medium ${tag.class} py-1 px-2.5`}
                      >
                        <tag.icon class="size-3.5" />
                        {tag.name}
                      </span>
                    ))}
                  </div>

                  <p class="mt-4 text-sm md:text-base leading-relaxed text-gray-700 dark:text-gray-300 text-pretty">
                    {description}
                  </p>

                  {highlights && highlights.length > 0 && (
                    <ul class="mt-4 space-y-1.5 text-xs md:text-sm text-gray-600 dark:text-gray-400">
                      {highlights.map((item) => (
                        <li class="flex items-center gap-2">
                          <span class="text-amber-500 font-bold">›</span>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <footer class="flex flex-wrap items-center justify-start mt-6 gap-3">
                  {caseStudy && (
                    <LinkButton href={caseStudy} class="border-amber-500/30 text-amber-600 dark:text-amber-400 hover:bg-amber-500/10">
                      <Book class="size-4" />
                      {t("projects.case_study")}
                    </LinkButton>
                  )}
                  {link && (
                    <LinkButton href={link}>
                      <Link class="size-4" />
                      Preview
                    </LinkButton>
                  )}
                  {github && (
                    <LinkButton href={github}>
                      <GitHub class="size-4" />
                      Code
                    </LinkButton>
                  )}
                </footer>
              </div>
            </div>
          )}
        </article>
      )
    )
  }

  <!-- Engineering Blog Callout Banner -->
  <div class="p-6 md:p-8 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gradient-to-r from-gray-50 via-white to-gray-50 dark:from-gray-900/40 dark:via-gray-900/60 dark:to-gray-900/40 flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="p-3 rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20">
        <Book class="size-6" />
      </div>
      <div>
        <h4 class="font-bold text-gray-900 dark:text-white text-base md:text-lg">
          {lang === "en" ? "Engineering Deep Dives & Articles" : "Artículos técnicos y arquitectura"}
        </h4>
        <p class="text-xs md:text-sm text-gray-600 dark:text-gray-400">
          {t("projects.view_blog")}
        </p>
      </div>
    </div>
    <LinkButton href={translatePath("/blog")} class="w-full md:w-auto font-mono text-sm">
      {lang === "en" ? "Explore Blog →" : "Explorar Blog →"}
    </LinkButton>
  </div>
</div>

<!-- Fullscreen Image Modal / Lightbox -->
<div
  id="project-image-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/85 backdrop-blur-md p-4 sm:p-8 transition-opacity duration-300 select-none"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <!-- Backdrop Click Area -->
  <div id="project-modal-backdrop" class="absolute inset-0 cursor-zoom-out"></div>

  <!-- Close Button -->
  <button
    type="button"
    id="project-modal-close"
    class="absolute top-4 right-4 z-20 p-2.5 rounded-full bg-neutral-900/80 hover:bg-neutral-800 text-white/80 hover:text-white border border-white/20 transition cursor-pointer shadow-lg"
    aria-label="Cerrar imagen ampliada"
  >
    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <!-- Content Box -->
  <div class="relative z-10 flex flex-col items-center max-w-full max-h-full">
    <img
      id="project-modal-img"
      src=""
      alt=""
      class="max-w-[94vw] max-h-[86vh] w-auto h-auto object-contain rounded-xl shadow-2xl border border-white/10"
    />
    <div
      id="project-modal-caption"
      class="mt-3 px-4 py-1.5 rounded-full bg-neutral-900/85 text-gray-200 text-xs font-mono border border-white/15 backdrop-blur-sm"
    >
    </div>
  </div>
</div>

<script>
  function setupImageModal() {
    const modal = document.getElementById("project-image-modal");
    const modalImg = document.getElementById("project-modal-img") as HTMLImageElement | null;
    const modalCaption = document.getElementById("project-modal-caption");
    const modalClose = document.getElementById("project-modal-close");
    const modalBackdrop = document.getElementById("project-modal-backdrop");
    const triggers = document.querySelectorAll<HTMLElement>(".project-image-trigger");

    if (!modal || !modalImg) return;

    function openModal(src: string, title: string) {
      if (!modal || !modalImg) return;
      modalImg.src = src;
      modalImg.alt = title;
      if (modalCaption) modalCaption.textContent = title;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    }

    function closeModal() {
      if (!modal || !modalImg) return;
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");
      modalImg.src = "";
      document.body.style.overflow = "";
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const src = trigger.getAttribute("data-modal-image");
        const title = trigger.getAttribute("data-modal-title") || "";
        if (src) openModal(src, title);
      });
      trigger.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          const src = trigger.getAttribute("data-modal-image");
          const title = trigger.getAttribute("data-modal-title") || "";
          if (src) openModal(src, title);
        }
      });
    });

    if (modalClose) modalClose.addEventListener("click", closeModal);
    if (modalBackdrop) modalBackdrop.addEventListener("click", closeModal);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
        closeModal();
      }
    });
  }

  setupImageModal();
  document.addEventListener("astro:after-swap", setupImageModal);
</script>

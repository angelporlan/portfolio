---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import Symfony from "./icons/Symfony.astro";
import NodeJS from "./icons/Node.astro";
import VueJS from "./icons/Vue.astro";
import Angular from "./icons/Angular.astro";
import OpenAiApi from "./icons/OpenAiApi.astro";
import Sparkles from "./icons/Sparkles.astro";
import Python from "./icons/Python.astro";
import Book from "./icons/Book.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  VUE: {
    name: "Vue.js",
    class: "bg-[#41B883] text-white flex items-center",
    icon: VueJS,
  },
  SYMFONY: {
    name: "Symfony",
    class: "bg-[#000000] text-white flex items-center",
    icon: Symfony,
  },
  NodeJS: {
    name: "Node.js",
    class: "bg-[#339933] text-white flex items-center gap-1",
    icon: NodeJS,
  },
  ANGULAR: {
    name: "Angular",
    class: "bg-[#DD0031] text-white flex items-center gap-1",
    icon: Angular,
  },
  OPENAI_API: {
    name: "OpenAI API",
    class: "bg-[#000] text-white flex items-center",
    icon: OpenAiApi,
  },
  AI: {
    name: "AI & LLMs",
    class: "bg-[#6366F1] text-white flex items-center gap-1",
    icon: Sparkles,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#3776AB] text-white flex items-center gap-1",
    icon: Python,
  },
};

const PROJECTS_ES = [
  {
    featured: true,
    title: "Matchply",
    subtitle: "SaaS de IA para optimización de CVs y tracking de candidaturas",
    description:
      "Plataforma inteligente que optimiza currículums automáticamente a partir de ofertas de empleo. Analiza la oferta en tiempo real mediante modelos de lenguaje, adapta el perfil del candidato de forma estratégica y facilita el seguimiento completo del proceso de postulación con generación de PDFs concurrentes y persistencia optimizada en PostgreSQL.",
    highlights: [
      "Optimización de consultas (-37.5% SELECTs en producción)",
      "Orquestación de agentes y evaluación de prompts RAG",
      "Renderizado concurrente de PDFs con workers dedicados",
      "Infraestructura en producción en VPS con CI/CD automatizado",
    ],
    github: "https://github.com/angelporlan",
    link: "https://matchply.com",
    caseStudy: "/blog/2026-10-22/rendimiento-matchply-antes-despues",
    image: "/projects/matchply.png",
    tags: [TAGS.AI, TAGS.NEXT, TAGS.TAILWIND],
  },
  {
    featured: false,
    title: "NutriScan",
    subtitle: "Visión artificial y nutrición asistida por IA",
    description:
      "Aplicación que analiza imágenes de alimentos y proporciona información nutricional detallada basada en IA, ayudando a tomar mejores decisiones alimentarias para un estilo de vida saludable mediante extracción de macronutrientes y estimación de calorías.",
    highlights: [
      "Extracción estructurada con modelos de visión multimodal",
      "Respuestas en tiempo real con latencia optimizada",
    ],
    github: "https://github.com/angelporlan",
    link: "https://paka-mu.vercel.app/",
    image: "/projects/nutriscan.png",
    tags: [TAGS.AI, TAGS.NodeJS],
  },
  {
    featured: false,
    title: "Codex Dashboard",
    subtitle: "Observabilidad y métricas de consumo para LLMs",
    description:
      "Dashboard interactivo para la monitorización de límites, consumo de tokens y análisis de uso de APIs de modelos de lenguaje (LLMs). Permite visualizar tendencias de input/output y gestionar hilos activos en tiempo real.",
    highlights: [
      "Tracking granular de costes y tokens consumidos",
      "Visualización reactiva de actividad de subagentes",
    ],
    github: "https://github.com/angelporlan/codex-dashboard",
    image: "/projects/codex-dashboard.png",
    tags: [TAGS.AI, TAGS.PYTHON],
  },
];

const PROJECTS_EN = [
  {
    featured: true,
    title: "Matchply",
    subtitle: "AI-Powered SaaS for Resume Optimization & Job Pipeline Tracking",
    description:
      "Intelligent platform that automatically optimizes resumes based on job postings. It analyzes requirements in real-time using LLMs, strategically tailors candidate profiles, and provides end-to-end application tracking with concurrent PDF generation and optimized PostgreSQL persistence.",
    highlights: [
      "Database query reduction (-37.5% SELECT overhead)",
      "Multi-agent orchestration & RAG prompt evaluation",
      "Concurrent PDF rendering via dedicated workers",
      "Production deployment on VPS with automated CI/CD",
    ],
    github: "https://github.com/angelporlan",
    link: "https://matchply.com",
    caseStudy: "/en/blog/2026-10-22/matchply-performance-before-after",
    image: "/projects/matchply.png",
    tags: [TAGS.AI, TAGS.NEXT, TAGS.TAILWIND],
  },
  {
    featured: false,
    title: "NutriScan",
    subtitle: "Computer Vision & AI-Assisted Nutrition",
    description:
      "Application that analyzes food photography and delivers detailed AI-powered nutritional insights, computing macronutrient distributions and calorie estimates in real time for health-conscious users.",
    highlights: [
      "Multimodal vision model parsing",
      "Low-latency real-time response pipeline",
    ],
    github: "https://github.com/angelporlan",
    link: "https://paka-mu.vercel.app/",
    image: "/projects/nutriscan.png",
    tags: [TAGS.AI, TAGS.NodeJS],
  },
  {
    featured: false,
    title: "Codex Dashboard",
    subtitle: "Observability & Usage Metrics for LLMs",
    description:
      "Interactive dashboard for monitoring rate limits, token expenditure, and API consumption trends across large language model providers. Visualizes input/output metrics and tracks active threads in real time.",
    highlights: [
      "Granular cost and token accounting",
      "Reactive visualization of subagent threads",
    ],
    github: "https://github.com/angelporlan/codex-dashboard",
    image: "/projects/codex-dashboard.png",
    tags: [TAGS.AI, TAGS.PYTHON],
  },
];

const PROJECTS = lang === "en" ? PROJECTS_EN : PROJECTS_ES;
---

<div class="flex flex-col gap-y-12">
  {
    PROJECTS.map(
      ({ featured, image, title, subtitle, description, highlights, tags, link, github, caseStudy }) => (
        <article
          class={`relative rounded-2xl transition duration-300 p-6 md:p-8 ${
            featured
              ? "bg-gradient-to-b from-amber-500/5 via-transparent to-transparent border-2 border-amber-500/30 dark:border-amber-400/20 shadow-xl dark:shadow-amber-950/10"
              : "border border-gray-200 dark:border-gray-800/80 bg-white/40 dark:bg-gray-900/30 hover:border-gray-300 dark:hover:border-gray-700 shadow-sm"
          }`}
        >
          {featured && (
            <div class="mb-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium tracking-wide uppercase bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              <Sparkles class="size-3.5" />
              {t("projects.featured")}
            </div>
          )}

          <div class="flex flex-col gap-8 md:flex-row md:items-start">
            <div class="w-full md:w-1/2">
              <div class="relative overflow-hidden rounded-xl border border-gray-200/80 dark:border-gray-800 bg-gray-100 dark:bg-gray-900 shadow-inner group">
                <img
                  alt={`${title} preview`}
                  class="object-cover object-top w-full h-56 transition duration-500 sm:h-64 group-hover:scale-105"
                  loading="lazy"
                  src={image}
                />
              </div>
            </div>

            <div class="w-full md:w-1/2 flex flex-col justify-between">
              <div>
                <h3 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                  {title}
                </h3>
                {subtitle && (
                  <p class="text-sm font-medium text-amber-600 dark:text-amber-400 mt-1">
                    {subtitle}
                  </p>
                )}

                <div class="flex flex-wrap gap-2 mt-3">
                  {tags.map((tag) => (
                    <span
                      class={`inline-flex items-center gap-x-1.5 rounded-full text-xs font-medium ${tag.class} py-1 px-2.5`}
                    >
                      <tag.icon class="size-3.5" />
                      {tag.name}
                    </span>
                  ))}
                </div>

                <p class="mt-4 text-sm md:text-base leading-relaxed text-gray-700 dark:text-gray-300 text-pretty">
                  {description}
                </p>

                {highlights && highlights.length > 0 && (
                  <ul class="mt-4 space-y-1.5 text-xs md:text-sm text-gray-600 dark:text-gray-400">
                    {highlights.map((item) => (
                      <li class="flex items-center gap-2">
                        <span class="text-amber-500 font-bold">›</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <footer class="flex flex-wrap items-center justify-start mt-6 gap-3">
                {caseStudy && (
                  <LinkButton href={caseStudy} class="border-amber-500/30 text-amber-600 dark:text-amber-400 hover:bg-amber-500/10">
                    <Book class="size-4" />
                    {t("projects.case_study")}
                  </LinkButton>
                )}
                {link && (
                  <LinkButton href={link}>
                    <Link class="size-4" />
                    Preview
                  </LinkButton>
                )}
                {github && (
                  <LinkButton href={github}>
                    <GitHub class="size-4" />
                    Code
                  </LinkButton>
                )}
              </footer>
            </div>
          </div>
        </article>
      )
    )
  }

  <!-- Engineering Blog Callout Banner -->
  <div class="p-6 md:p-8 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gradient-to-r from-gray-50 via-white to-gray-50 dark:from-gray-900/40 dark:via-gray-900/60 dark:to-gray-900/40 flex flex-col md:flex-row items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="p-3 rounded-xl bg-amber-500/10 text-amber-500 border border-amber-500/20">
        <Book class="size-6" />
      </div>
      <div>
        <h4 class="font-bold text-gray-900 dark:text-white text-base md:text-lg">
          {lang === "en" ? "Engineering Deep Dives & Articles" : "Artículos técnicos y arquitectura"}
        </h4>
        <p class="text-xs md:text-sm text-gray-600 dark:text-gray-400">
          {t("projects.view_blog")}
        </p>
      </div>
    </div>
    <LinkButton href={translatePath("/blog")} class="w-full md:w-auto font-mono text-sm">
      {lang === "en" ? "Explore Blog →" : "Explorar Blog →"}
    </LinkButton>
  </div>
</div>

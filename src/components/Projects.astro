---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import Tailwind from "./icons/Tailwind.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import Symfony from "./icons/Symfony.astro";
import NodeJS from "./icons/Node.astro";
import VueJS from "./icons/Vue.astro";
import Angular from "./icons/Angular.astro";
import OpenAiApi from "./icons/OpenAiApi.astro";
import Sparkles from "./icons/Sparkles.astro";
import Python from "./icons/Python.astro";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  VUE: {
    name: "Vue.js",
    class: "bg-[#41B883] text-white flex items-center",
    icon: VueJS,
  },
  SYMFONY: {
    name: "Symfony",
    class: "bg-[#000000] text-white flex items-center",
    icon: Symfony,
  },
  NodeJS: {
    name: "Node.js",
    class: "bg-[#339933] text-white flex items-center gap-1",
    icon: NodeJS,
  },
  ANGULAR: {
    name: "Angular",
    class: "bg-[#DD0031] text-white flex items-center gap-1",
    icon: Angular,
  },
  OPENAI_API: {
    name: "OpenAI API",
    class: "bg-[#000] text-white flex items-center",
    icon: OpenAiApi,
  },
  AI: {
    name: "AI & LLMs",
    class: "bg-[#6366F1] text-white flex items-center gap-1",
    icon: Sparkles,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#3776AB] text-white flex items-center gap-1",
    icon: Python,
  },
};

const PROJECTS_ES = [
  {
    title: "Matchply",
    description:
      "Plataforma inteligente que optimiza currículums automáticamente a partir de ofertas de empleo. Analiza la oferta en tiempo real mediante modelos de lenguaje, adapta el perfil del candidato de forma estratégica y facilita el seguimiento completo del proceso de postulación.",
    github: "https://github.com/angelporlan",
    link: "https://matchply.com",
    image: "/projects/matchply.png",
    tags: [TAGS.AI, TAGS.NEXT],
  },
  {
    title: "NutriScan",
    description:
      "Aplicación que analiza imágenes de alimentos y proporciona información nutricional detallada basada en IA, ayudando a tomar mejores decisiones alimentarias para un estilo de vida saludable.",
    github: "https://github.com/angelporlan",
    link: "https://paka-mu.vercel.app/",
    image: "/projects/nutriscan.png",
    tags: [TAGS.AI, TAGS.NodeJS],
  },
  {
    title: "Codex Dashboard",
    description:
      "Dashboard interactivo para la monitorización de límites, consumo de tokens y análisis de uso de APIs de modelos de lenguaje (LLMs). Permite visualizar tendencias de input/output y gestionar hilos activos en tiempo real.",
    github: "https://github.com/angelporlan/codex-dashboard",
    image: "/projects/codex-dashboard.png",
    tags: [TAGS.AI, TAGS.PYTHON],
  },
];

const PROJECTS_EN = [
  {
    title: "Matchply",
    description:
      "Intelligent platform that automatically optimizes resumes based on job offers. It analyzes the job post in real-time using large language models, adapts the candidate's profile strategically, and enables comprehensive tracking of the application pipeline.",
    github: "https://github.com/angelporlan",
    link: "https://matchply.com",
    image: "/projects/matchply.png",
    tags: [TAGS.AI, TAGS.NEXT],
  },
  {
    title: "NutriScan",
    description:
      "Application that analyzes food images and provides detailed nutritional information powered by AI, helping users make better eating choices for a healthy lifestyle.",
    github: "https://github.com/angelporlan",
    link: "https://paka-mu.vercel.app/",
    image: "/projects/nutriscan.png",
    tags: [TAGS.AI, TAGS.NodeJS],
  },
  {
    title: "Codex Dashboard",
    description:
      "Interactive dashboard for monitoring API limits, token consumption, and usage analysis of large language models (LLMs). It visualizes input/output trends and tracks active conversation threads in real time.",
    github: "https://github.com/angelporlan/codex-dashboard",
    image: "/projects/codex-dashboard.png",
    tags: [TAGS.AI, TAGS.PYTHON],
  },
];

const PROJECTS = lang === "en" ? PROJECTS_EN : PROJECTS_ES;
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img
              alt="Project img"
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2 `}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">
              {description}
            </div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>

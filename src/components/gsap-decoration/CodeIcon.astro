---
const { urlimage } = Astro.props;
---

<img id="code-icon" src={urlimage} alt="code icon" class="w-8 h-8" />

<script>
  import { gsap } from "gsap";

  const codeIcon = document.getElementById("code-icon");

  if (codeIcon) {
    gsap.to(codeIcon, { 
      rotation: 360,
      duration: 1,
      repeat: Infinity,
      delay: 0,
      repeatDelay: 0,
    });
  }
</script>

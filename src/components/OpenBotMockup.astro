---
interface Props {
  lang?: string;
}

const { lang = "es" } = Astro.props;

const isEn = lang === "en";

const userMessage = isEn
  ? "Sprint goal: sync LeadOn metrics, deploy Matchply query optimization, and verify portfolio redesign build."
  : "Plan para el sprint: sincronizar métricas de LeadOn, desplegar la optimización de queries en Matchply y publicar el rediseño del portfolio.";

const messages = [
  {
    agent: "Atlas",
    role: isEn ? "Team lead" : "Team lead",
    color: "#F97316", // orange
    bgColor: "bg-orange-500/10",
    borderColor: "border-orange-500/30",
    textColor: "text-orange-400",
    avatarBg: "#E05A1B",
    avatarEye: "#3A1A05",
    time: "19:34",
    text: isEn
      ? "Got it. Splitting work: Forge verifies the portfolio build on Vercel, Scout audits query latency in Matchply, and Pulse monitors LeadOn Stripe events."
      : "Entendido. Reparto tareas: Forge se encarga del build y Vercel en el portfolio, Scout audita la latencia en Matchply, y Pulse monitoriza los eventos de Stripe en LeadOn.",
  },
  {
    agent: "Forge",
    role: isEn ? "Builder" : "Builder",
    color: "#10B981", // green
    bgColor: "bg-emerald-500/10",
    borderColor: "border-emerald-500/30",
    textColor: "text-emerald-400",
    avatarBg: "#10B981",
    avatarEye: "#042F24",
    time: "19:35",
    text: isEn
      ? "PR #1 merged in portfolio. Astro static build passing tests, assets optimized and live on Vercel production."
      : "PR #1 mergeada en el portfolio. Build estático en Astro pasando tests, assets optimizados y listo en Vercel prod.",
  },
  {
    agent: "Scout",
    role: isEn ? "Research" : "Research",
    color: "#38BDF8", // sky blue
    bgColor: "bg-sky-500/10",
    borderColor: "border-sky-500/30",
    textColor: "text-sky-400",
    avatarBg: "#38BDF8",
    avatarEye: "#082F49",
    time: "19:36",
    text: isEn
      ? "Matchply PostgreSQL query plan verified in production: -37.5% SELECT overhead and zero RAG regressions."
      : "Query plan en Matchply verificado en producción: -37.5% de SELECTs y cero regresiones en los pipelines RAG.",
  },
  {
    agent: "Pulse",
    role: isEn ? "Signals" : "Signals",
    color: "#A855F7", // purple
    bgColor: "bg-purple-500/10",
    borderColor: "border-purple-500/30",
    textColor: "text-purple-400",
    avatarBg: "#A855F7",
    avatarEye: "#2E1065",
    time: "19:37",
    text: isEn
      ? "LeadOn Redis BullMQ queues live: 100% of webhooks and automated billing events processed nominal."
      : "Colas Redis BullMQ de LeadOn en producción: 100% de webhooks y facturación procesados sin alertas.",
  },
];
---

<div class="openbot-window w-full rounded-xl overflow-hidden border border-[#2b2d35] bg-[#121316] text-[#e1e2e6] shadow-2xl font-sans text-xs select-none">
  <!-- macOS Titlebar -->
  <div class="h-9 bg-[#18191e] border-b border-[#262830] px-3 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <!-- Window Controls -->
      <div class="flex items-center gap-1.5 mr-1">
        <span class="w-2.5 h-2.5 rounded-full bg-[#FF5F56] border border-[#E0443E]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E] border border-[#DEA123]"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#27C93F] border border-[#1AAB29]"></span>
      </div>

      <!-- App Workspace Dropdown -->
      <div class="flex items-center gap-1.5 px-2 py-0.5 rounded hover:bg-white/5 cursor-pointer text-gray-300 font-medium">
        <svg class="w-3.5 h-3.5 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="10" rx="2"></rect>
          <circle cx="12" cy="5" r="2"></circle>
          <path d="M12 7v4"></path>
          <line x1="8" y1="16" x2="8" y2="16"></line>
          <line x1="16" y1="16" x2="16" y2="16"></line>
        </svg>
        <span class="text-[11px] font-semibold text-gray-200">OpenBot team</span>
        <svg class="w-2.5 h-2.5 text-gray-400 opacity-60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>

      <!-- Channel Breadcrumb -->
      <div class="hidden sm:flex items-center gap-1.5 text-gray-400 text-[11px] ml-2 pl-2 border-l border-gray-700/60">
        <span class="flex items-center -space-x-1">
          <span class="w-2 h-2 rounded-full bg-orange-500"></span>
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        </span>
        <span class="font-bold text-gray-200">#launch</span>
        <span class="text-gray-500 text-[10px]">Friday launch</span>
      </div>
    </div>

    <!-- Window Actions / Live Indicator -->
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[10px] font-mono border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>4 agents active</span>
      </span>
      <button
        type="button"
        id="openbot-replay-btn"
        class="px-2 py-0.5 rounded bg-gray-800 hover:bg-gray-700 text-gray-300 text-[10px] transition flex items-center gap-1 border border-gray-700"
        title="Replay simulated conversation"
      >
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="5 3 19 12 5 21 5 3"></polygon>
        </svg>
        <span>{isEn ? "Replay" : "Simular"}</span>
      </button>
    </div>
  </div>

  <!-- Main Window Body -->
  <div class="flex h-[320px] sm:h-[350px] overflow-hidden bg-[#121316]">
    <!-- Left Icon Rail -->
    <div class="w-9 bg-[#0e0f12] border-r border-[#22242b] py-2 flex flex-col items-center justify-between shrink-0">
      <div class="flex flex-col items-center gap-3 text-gray-400">
        <!-- Robot Active -->
        <button class="w-6 h-6 rounded-md bg-purple-500/20 text-purple-400 flex items-center justify-center">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="10" rx="2"></rect>
            <circle cx="12" cy="5" r="2"></circle>
            <path d="M12 7v4"></path>
          </svg>
        </button>
        <!-- Git/Branches -->
        <div class="text-gray-500 hover:text-gray-300">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="18" cy="18" r="3"></circle>
            <circle cx="6" cy="6" r="3"></circle>
            <path d="M6 9a9 9 0 0 1 9 9"></path>
          </svg>
        </div>
        <!-- Check Tasks -->
        <div class="text-gray-500 hover:text-gray-300">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 11 12 14 22 4"></polyline>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
          </svg>
        </div>
        <!-- Clock / Routines -->
        <div class="text-gray-500 hover:text-gray-300">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
      </div>
      <!-- Bottom Settings -->
      <div class="text-gray-600">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
      </div>
    </div>

    <!-- Sidebar: Channels & Agent Roster -->
    <div class="w-36 sm:w-44 bg-[#14151a] border-r border-[#22242b] p-2 flex flex-col justify-between shrink-0 overflow-y-auto">
      <div class="space-y-3">
        <!-- Search bar -->
        <div class="flex items-center gap-1.5 px-2 py-1 bg-[#1a1b22] border border-[#262832] rounded text-[10px] text-gray-400">
          <svg class="w-3 h-3 text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="truncate">{isEn ? "Search..." : "Buscar..."}</span>
        </div>

        <!-- Section: Channels -->
        <div>
          <div class="text-[9px] font-semibold text-gray-400 uppercase tracking-wider px-1 mb-1">
            {isEn ? "Channels" : "Canales"}
          </div>
          <button
            type="button"
            data-filter="all"
            class="agent-filter-btn w-full flex items-center justify-between px-1.5 py-1 rounded bg-[#1e2028] text-gray-200 font-medium text-left border border-purple-500/30"
          >
            <div class="flex items-center gap-1.5 truncate">
              <span class="flex items-center -space-x-1">
                <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              </span>
              <span class="truncate font-semibold text-[11px]">#launch</span>
            </div>
            <span class="text-[9px] bg-purple-500/20 text-purple-300 px-1 rounded font-mono">all</span>
          </button>
        </div>

        <!-- Section: Agents Roster -->
        <div>
          <div class="text-[9px] font-semibold text-gray-400 uppercase tracking-wider px-1 mb-1">
            Agents ({messages.length})
          </div>
          <div class="space-y-1">
            {messages.map((m) => (
              <button
                type="button"
                data-filter={m.agent.toLowerCase()}
                class="agent-filter-btn w-full flex items-center gap-1.5 px-1.5 py-1 rounded hover:bg-[#1c1d25] text-left transition group text-gray-300 hover:text-white"
              >
                <!-- Mini Cute Bot Avatar -->
                <span
                  class="w-4 h-3 rounded-full flex items-center justify-center shrink-0 border border-white/10"
                  style={`background-color: ${m.avatarBg}`}
                >
                  <span class="w-1 h-0.5 rounded-full" style={`background-color: ${m.avatarEye}`}></span>
                </span>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between">
                    <span class="text-[11px] font-medium truncate group-hover:text-amber-400">{m.agent}</span>
                    <span class="text-[8px] font-mono opacity-50">{m.time}</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-[8px] px-1 rounded bg-white/5 text-gray-400">{m.role}</span>
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                  </div>
                </div>
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- Footer Info -->
      <div class="pt-2 border-t border-gray-800/60 text-[9px] text-gray-400 flex items-center justify-between px-1">
        <span>MCP Mesh</span>
        <span class="text-emerald-400 font-mono">Sync OK</span>
      </div>
    </div>

    <!-- Right: Chat Dialogue Area -->
    <div class="flex-1 flex flex-col justify-between bg-[#16171d] overflow-hidden">
      <!-- Chat message scroll container -->
      <div id="openbot-chat-stream" class="flex-1 p-3 overflow-y-auto space-y-2.5 scroll-smooth">
        <div class="text-center my-1">
          <span class="text-[9px] px-2 py-0.5 rounded-full bg-[#1e2028] text-gray-400 font-mono">
            {isEn ? "Today 19:33 · Autonomous Orchestration Session" : "Hoy 19:33 · Sesión de Orquestación Autónoma"}
          </span>
        </div>

        <!-- User Prompt -->
        <div class="flex justify-end">
          <div class="max-w-[88%] bg-[#252833] text-gray-200 border border-[#323644] rounded-2xl rounded-tr-sm px-3 py-2 text-[11px] shadow-sm">
            <div class="text-[9px] font-semibold text-amber-400 mb-0.5">Angel Porlán (Product Lead)</div>
            <p class="leading-relaxed">{userMessage}</p>
          </div>
        </div>

        <!-- Agent Response Messages -->
        {messages.map((m, idx) => (
          <div
            class="openbot-msg flex items-start gap-2 text-[11px] transition duration-300"
            data-agent={m.agent.toLowerCase()}
            data-step={idx}
          >
            <!-- Cute Bot Capsule Avatar -->
            <div
              class="w-5 h-4 mt-0.5 rounded-full flex items-center justify-center shrink-0 shadow-sm border border-white/20"
              style={`background-color: ${m.avatarBg}`}
            >
              <div class="flex items-center gap-0.5">
                <span class="w-0.5 h-1 rounded-full" style={`background-color: ${m.avatarEye}`}></span>
                <span class="w-0.5 h-1 rounded-full" style={`background-color: ${m.avatarEye}`}></span>
              </div>
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5 mb-0.5">
                <span class={`font-bold text-[11px] ${m.textColor}`}>{m.agent}</span>
                <span class="text-[8px] px-1 py-0.2 rounded bg-white/5 border border-white/5 text-gray-400">
                  {m.role}
                </span>
                <span class="text-[9px] text-gray-400 font-mono">{m.time}</span>
              </div>
              <div class="bg-[#1c1d25] border border-[#2a2d39] rounded-xl rounded-tl-sm p-2 text-gray-300 leading-relaxed">
                {m.text}
              </div>
            </div>
          </div>
        ))}

        <!-- Typing status indicator (hidden by default) -->
        <div id="openbot-typing" class="hidden items-center gap-2 text-gray-400 text-[10px] pl-7 italic">
          <span class="inline-flex gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.2s]"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.4s]"></span>
          </span>
          <span id="openbot-typing-text">Pulse is checking Redis telemetry...</span>
        </div>
      </div>

      <!-- Chat Input Area -->
      <div class="p-2 bg-[#14151a] border-t border-[#22242b]">
        <div class="flex items-center gap-1.5 px-2.5 py-1.5 bg-[#1b1c24] border border-[#2a2d39] rounded-xl text-gray-400">
          <button type="button" class="w-4 h-4 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-gray-400 hover:text-white transition">
            <span class="text-xs leading-none">+</span>
          </button>
          <input
            id="openbot-input"
            type="text"
            readonly
            value={isEn ? "All systems verified across LeadOn, Matchply & Portfolio" : "Sistemas verificados en LeadOn, Matchply y Portfolio"}
            class="flex-1 bg-transparent border-none text-[10px] text-gray-300 focus:outline-none cursor-default truncate"
          />
          <button
            type="button"
            id="openbot-send-btn"
            class="w-5 h-5 rounded-full bg-white hover:bg-gray-200 text-black flex items-center justify-center shrink-0 transition"
            title="Replay sequence"
          >
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="12" y1="19" x2="12" y2="5"></line>
              <polyline points="5 12 12 5 19 12"></polyline>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function setupOpenBotMockup() {
    const replayBtn = document.getElementById("openbot-replay-btn");
    const sendBtn = document.getElementById("openbot-send-btn");
    const messages = document.querySelectorAll<HTMLElement>(".openbot-msg");
    const typingIndicator = document.getElementById("openbot-typing");
    const typingText = document.getElementById("openbot-typing-text");
    const chatStream = document.getElementById("openbot-chat-stream");
    const filterBtns = document.querySelectorAll<HTMLElement>(".agent-filter-btn");

    // Agent filters
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const filter = btn.getAttribute("data-filter");
        filterBtns.forEach((b) => b.classList.remove("border-purple-500/30", "bg-[#1e2028]"));
        btn.classList.add("border-purple-500/30", "bg-[#1e2028]");

        messages.forEach((msg) => {
          const agent = msg.getAttribute("data-agent");
          if (filter === "all" || agent === filter) {
            msg.style.display = "flex";
            msg.classList.add("opacity-100");
          } else {
            msg.style.display = "none";
          }
        });
      });
    });

    // Replay / Step-by-step animation
    function runSimulation() {
      // Reset filter to all
      filterBtns.forEach((b) => {
        if (b.getAttribute("data-filter") === "all") {
          b.classList.add("border-purple-500/30", "bg-[#1e2028]");
        } else {
          b.classList.remove("border-purple-500/30", "bg-[#1e2028]");
        }
      });

      // Hide all agent messages
      messages.forEach((msg) => {
        msg.style.display = "none";
        msg.classList.remove("opacity-100");
      });

      if (typingIndicator) {
        typingIndicator.classList.remove("hidden");
        typingIndicator.classList.add("flex");
      }

      const agentNames = ["Atlas", "Forge", "Scout", "Pulse"];
      const phrases = [
        "Atlas is analyzing the sprint objectives...",
        "Forge is compiling Astro static build & checking Vercel...",
        "Scout is inspecting PostgreSQL query planner in Matchply...",
        "Pulse is verifying LeadOn Redis BullMQ queues...",
      ];

      messages.forEach((msg, idx) => {
        setTimeout(() => {
          if (typingText) typingText.innerText = phrases[idx] || "Agent is collaborating...";
          if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
        }, idx * 900);

        setTimeout(() => {
          msg.style.display = "flex";
          msg.classList.add("opacity-100");
          if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;

          if (idx === messages.length - 1 && typingIndicator) {
            typingIndicator.classList.add("hidden");
            typingIndicator.classList.remove("flex");
          }
        }, (idx + 1) * 900);
      });
    }

    if (replayBtn) replayBtn.addEventListener("click", runSimulation);
    if (sendBtn) sendBtn.addEventListener("click", runSimulation);
  }

  // Run on mount and Astro page swaps
  setupOpenBotMockup();
  document.addEventListener("astro:after-swap", setupOpenBotMockup);
</script>

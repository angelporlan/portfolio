const STACK = lang === "en" ? STACK_EN : STACK_ES;
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-8">
  {Object.entries(STACK).map(([key, category]) => (
    <div class="p-6 bg-white/50 dark:bg-gray-800/30 border border-gray-200 dark:border-gray-700/50 rounded-2xl backdrop-blur-sm shadow-sm transition hover:shadow-md">
      <h3 class="text-lg font-bold text-gray-800 dark:text-gray-100 mb-4 border-b border-gray-100 dark:border-gray-700/50 pb-2">
        {category.title}
      </h3>
      <ul class="space-y-3">
        {category.items.map((item) => (
          <li class="flex items-center gap-3 text-gray-700 dark:text-gray-300">
            {item.icon ? (
              <item.icon class={`size-6 ${item.color}`} />
            ) : (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class={`size-6 ${item.color}`}
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={item.svg}
              />
            )}
            <span class="font-medium text-sm">{item.name}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

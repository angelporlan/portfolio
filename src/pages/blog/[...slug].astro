---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@/i18n/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.lang === "es");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const headings2 = headings.filter((h) => h.depth === 2);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const formattedDate = post.data.date.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const translatedUrl = post.data.translation ? `/en/blog/${post.data.translation}` : undefined;
---

<Layout
  title={`${post.data.title} · Blog de Ángel Porlán`}
  description={post.data.subtitle}
  translatedUrl={translatedUrl}
>
  <main class="px-4">
    <SectionContainer class="py-24 md:py-36">
      {/* Back button */}
      <a
        href={translatePath("/blog")}
        class="inline-flex items-center text-sm font-semibold text-blue-500 hover:text-blue-600 dark:text-blue-400 dark:hover:text-blue-300 transition-colors mb-8 group"
      >
        <span class="mr-1 group-hover:-translate-x-1 transition-transform duration-200">&larr;</span> {t("blog.back")}
      </a>

      <article class="max-w-5xl mx-auto">
        <header class="mb-10 border-b border-gray-200/50 dark:border-gray-800/50 pb-8">
          <div class="flex flex-wrap gap-2 mb-4">
            {
              post.data.tags.map((tag) => (
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-100/50 dark:border-blue-900/30">
                  {tag}
                </span>
              ))
            }
          </div>
          <h1 class="text-3xl md:text-5xl font-bold text-gray-800 dark:text-gray-100 leading-tight mb-4">
            {post.data.title}
          </h1>
          <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 leading-relaxed font-medium mb-4">
            {post.data.subtitle}
          </p>
          <time datetime={post.data.date.toISOString()} class="text-sm text-gray-500 dark:text-gray-500">
            Publicado el {formattedDate}
          </time>
        </header>

        {/* 2-Column Grid */}
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 mt-8">
          {/* Table of Contents (Sticky sidebar) */}
          <aside class="hidden lg:block lg:col-span-3 sticky top-32 h-fit pr-4 border-r border-gray-200/50 dark:border-gray-800/50">
            <nav class="space-y-4">
              <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 dark:text-gray-500">
                {lang === "es" ? "En este artículo" : "In this article"}
              </h4>
              <ul class="space-y-3">
                {
                  headings2.map((heading) => (
                    <li>
                      <a
                        href={`#${heading.slug}`}
                        class="toc-link block text-sm text-gray-500 dark:text-gray-400 hover:text-blue-500 dark:hover:text-blue-400 transition-colors duration-200 pl-3 border-l-2 border-transparent"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </aside>

          {/* Content container */}
          <div class="lg:col-span-9 max-w-3xl prose-content w-full">
            <Content />
          </div>
        </div>
      </article>
    </SectionContainer>
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    // Create overlay if it doesn't exist
    let overlay = document.getElementById("image-zoom-overlay");
    if (!overlay) {
      overlay = document.createElement("div");
      overlay.id = "image-zoom-overlay";
      overlay.className = "zoom-overlay";
      overlay.innerHTML = '<img src="" alt="Zoomed Image" />';
      document.body.appendChild(overlay);
    }

    const currentOverlay = overlay;
    if (currentOverlay) {
      currentOverlay.addEventListener("click", () => {
        currentOverlay.classList.remove("active");
      });

      const zoomImg = currentOverlay.querySelector("img");

      // Add click listener to all post images using event delegation on the container
      const container = document.querySelector(".prose-content");
      if (container) {
        container.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          if (target && target.tagName === "IMG") {
            e.preventDefault();
            const src = target.getAttribute("src");
            const alt = target.getAttribute("alt") || "Zoomed Image";
            if (zoomImg && src) {
              zoomImg.setAttribute("src", src);
              zoomImg.setAttribute("alt", alt);
              currentOverlay.classList.add("active");
            }
          }
        });
      }
    }

    const headings = Array.from(document.querySelectorAll(".prose-content h2"));
    const links = document.querySelectorAll(".toc-link");

    if (headings.length === 0 || links.length === 0) return;

    const activeLink = (id: string) => {
      links.forEach((link) => {
        if (link.getAttribute("href") === `#${id}`) {
          link.classList.add("active", "text-blue-500", "dark:text-blue-400", "border-blue-500", "font-medium");
          link.classList.remove("text-gray-500", "dark:text-gray-400", "border-transparent");
        } else {
          link.classList.remove("active", "text-blue-500", "dark:text-blue-400", "border-blue-500", "font-medium");
          link.classList.add("text-gray-500", "dark:text-gray-400", "border-transparent");
        }
      });
    };

    const callback = (entries: IntersectionObserverEntry[]) => {
      const visible = entries.find((e) => e.isIntersecting);
      if (visible) {
        activeLink(visible.target.id);
      }
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "-100px 0px -60% 0px",
      threshold: 0,
    });

    headings.forEach((h) => observer.observe(h));
  });
</script>

<style>
  .prose-content :global(h2) {
    @apply text-2xl font-bold mt-10 mb-4 text-gray-800 scroll-m-20;
  }
  .prose-content :global(h3) {
    @apply text-xl font-bold mt-8 mb-3 text-gray-800 scroll-m-20;
  }
  .prose-content :global(p) {
    @apply text-base text-gray-700 leading-relaxed mb-6;
  }
  .prose-content :global(ul) {
    @apply list-disc pl-6 mb-6 text-gray-700 space-y-2;
  }
  .prose-content :global(ol) {
    @apply list-decimal pl-6 mb-6 text-gray-700 space-y-2;
  }
  .prose-content :global(li) {
    @apply leading-relaxed;
  }
  .prose-content :global(a) {
    @apply text-blue-600 hover:text-blue-700 underline font-medium transition-colors;
  }
  .prose-content :global(pre) {
    @apply bg-gray-900 text-gray-100 p-4 rounded-xl overflow-x-auto my-6 border border-gray-800 font-mono text-sm leading-relaxed;
  }
  .prose-content :global(code) {
    @apply bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-pink-600;
  }
  .prose-content :global(pre code) {
    @apply bg-transparent p-0 text-inherit text-sm font-mono;
  }
  .prose-content :global(blockquote) {
    @apply pl-4 border-l-4 border-blue-500/50 italic text-gray-600 my-6;
  }
  .prose-content :global(img) {
    @apply rounded-xl shadow-md my-8 mx-auto object-cover max-w-full cursor-zoom-in;
  }
  .prose-content :global(hr) {
    @apply border-gray-200/50 my-10;
  }

  /* Zoom modal style */
  :global(.zoom-overlay) {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(255, 255, 255, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  :global(.dark .zoom-overlay) {
    background: rgba(15, 23, 42, 0.95) !important;
  }
  :global(.zoom-overlay.active) {
    opacity: 1;
    pointer-events: auto;
  }
  :global(.zoom-overlay img) {
    max-width: 90vw;
    max-height: 90vh;
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    transform: scale(0.95);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: zoom-out;
  }
  :global(.zoom-overlay.active img) {
    transform: scale(1);
  }

  /* Dark mode overrides */
  :global(.dark) .prose-content :global(h2),
  :global(.dark) .prose-content :global(h3) {
    @apply text-gray-100;
  }
  :global(.dark) .prose-content :global(p),
  :global(.dark) .prose-content :global(ul),
  :global(.dark) .prose-content :global(ol),
  :global(.dark) .prose-content :global(li) {
    @apply text-gray-300;
  }
  :global(.dark) .prose-content :global(a) {
    @apply text-blue-400 hover:text-blue-300;
  }
  :global(.dark) .prose-content :global(code) {
    @apply bg-gray-800/80 text-pink-400;
  }
  :global(.dark) .prose-content :global(blockquote) {
    @apply text-gray-400;
  }
  :global(.dark) .prose-content :global(hr) {
    @apply border-gray-800/50;
  }
</style>

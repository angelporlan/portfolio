---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import SectionContainer from "@/components/SectionContainer.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "@/i18n/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => data.lang === "es");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const formattedDate = post.data.date.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={`${post.data.title} · Blog de Ángel Porlán`}
  description={post.data.subtitle}
>
  <main class="px-4">
    <SectionContainer class="py-24 md:py-36">
      {/* Back button */}
      <a
        href={translatePath("/blog")}
        class="inline-flex items-center text-sm font-semibold text-blue-500 hover:text-blue-600 dark:text-blue-400 dark:hover:text-blue-300 transition-colors mb-8 group"
      >
        <span class="mr-1 group-hover:-translate-x-1 transition-transform duration-200">&larr;</span> {t("blog.back")}
      </a>

      <article class="max-w-3xl mx-auto">
        <header class="mb-10 border-b border-gray-200/50 dark:border-gray-800/50 pb-8">
          <div class="flex flex-wrap gap-2 mb-4">
            {
              post.data.tags.map((tag) => (
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-100/50 dark:border-blue-900/30">
                  {tag}
                </span>
              ))
            }
          </div>
          <h1 class="text-3xl md:text-5xl font-bold text-gray-800 dark:text-gray-100 leading-tight mb-4">
            {post.data.title}
          </h1>
          <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 leading-relaxed font-medium mb-4">
            {post.data.subtitle}
          </p>
          <time datetime={post.data.date.toISOString()} class="text-sm text-gray-500 dark:text-gray-500">
            Publicado el {formattedDate}
          </time>
        </header>

        {/* Content container */}
        <div class="prose-content">
          <Content />
        </div>
      </article>
    </SectionContainer>
  </main>
</Layout>

<style>
  .prose-content :global(h2) {
    @apply text-2xl font-bold mt-10 mb-4 text-gray-800 dark:text-gray-100 scroll-m-20;
  }
  .prose-content :global(h3) {
    @apply text-xl font-bold mt-8 mb-3 text-gray-800 dark:text-gray-100 scroll-m-20;
  }
  .prose-content :global(p) {
    @apply text-base text-gray-700 dark:text-gray-300 leading-relaxed mb-6;
  }
  .prose-content :global(ul) {
    @apply list-disc pl-6 mb-6 text-gray-700 dark:text-gray-300 space-y-2;
  }
  .prose-content :global(ol) {
    @apply list-decimal pl-6 mb-6 text-gray-700 dark:text-gray-300 space-y-2;
  }
  .prose-content :global(li) {
    @apply leading-relaxed;
  }
  .prose-content :global(a) {
    @apply text-blue-500 hover:text-blue-600 dark:text-blue-400 dark:hover:text-blue-300 underline font-medium transition-colors;
  }
  .prose-content :global(pre) {
    @apply bg-gray-900 text-gray-100 p-4 rounded-xl overflow-x-auto my-6 border border-gray-800 font-mono text-sm leading-relaxed;
  }
  .prose-content :global(code) {
    @apply bg-gray-100 dark:bg-gray-800/80 px-1.5 py-0.5 rounded text-sm font-mono text-pink-600 dark:text-pink-400;
  }
  .prose-content :global(pre code) {
    @apply bg-transparent p-0 text-inherit text-sm font-mono;
  }
  .prose-content :global(blockquote) {
    @apply pl-4 border-l-4 border-blue-500/50 italic text-gray-600 dark:text-gray-400 my-6;
  }
  .prose-content :global(img) {
    @apply rounded-xl shadow-md my-8 mx-auto object-cover max-w-full;
  }
  .prose-content :global(hr) {
    @apply border-gray-200/50 dark:border-gray-800/50 my-10;
  }
</style>
